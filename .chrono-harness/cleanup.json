{
  "schema": "chrono-worktree-automatic-cleanup/v2",
  "coordinator_root": "git-main-worktree",
  "state_directory": ".chrono-harness/state/automatic-cleanup-v2/",
  "retained_ref": "refs/heads/dev",
  "retention": "same-tree",
  "remove_branch": false,
  "allow_evidence_disposal": false,
  "artifacts": [
    {
      "path": ".chrono-harness/bin/",
      "disposition": "retain"
    },
    {
      "path": ".chrono-harness/state/",
      "disposition": "evidence-retain"
    },
    {
      "path": "crates/runner/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/runner-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/instructions/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/instructions-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-ci/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-ci-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/ci/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/ci-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-registration/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-registration-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-filemap/target/",
