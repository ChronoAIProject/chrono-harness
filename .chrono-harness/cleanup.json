    },
    {
      "path": "crates/judge-filemap-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-routes/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-routes-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-projects/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-projects-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-cost/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-cost-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-mixed/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-mixed-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-workflow/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-workflow-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/inputs/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/inputs-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/distribution/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/distribution-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": ".chrono-harness/cache/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-cargo/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/judge-cargo-tests/target/",
      "disposition": "dispose"
    },
    {
      "path": "crates/worktree/target/",
      "disposition": "dispose"
