{
  "schema": "chrono-pr-config/v2",
  "repository": "ChronoAIProject/chrono-harness",
  "base": "dev",
  "gh": "gh",
  "required_checks": [
    "chrono / collection"
  ],
  "api_timeout_seconds": 60,
  "watch_timeout_seconds": 3600,
  "watch_interval_seconds": 60,
  "output_limit_bytes": 1048576,
  "state_directory": ".chrono-harness/state/pr-operations",
  "state_producer": "pr-original"
}
