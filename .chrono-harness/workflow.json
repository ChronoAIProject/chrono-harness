{
  "schema_version": 2,
  "status": "proposed",
  "target_branch": "dev",
  "feature_prefix": "feature/",
  "integration_prefix": "integration/",
  "staleness": {
    "max_behind_commits": 3,
    "max_age_hours": 24,
    "combine": "any-exceeded"
  },
  "stability": [
    {
      "id": "runner-engine",
      "paths": [
        "crates/runner/src/lib.rs",
        "crates/runner/src/main.rs",
        "crates/runner/Cargo.toml",
        "crates/runner/Cargo.lock",
        "crates/runner/src/wire.rs",
        "crates/runner/src/facts.rs",
        "crates/runner/src/full.rs",
        "crates/runner/src/observation.rs",
        "crates/runner/src/checkout.rs"
      ],
      "tests": [
        "runner-tests"
      ],
      "reason": "CLI/protocol and future judge engine evolution"
    },
    {
      "id": "instructions-generator",
      "paths": [
        "crates/instructions/src/lib.rs",
        "crates/instructions/src/catalog.rs",
        "crates/instructions/src/main.rs",
        "crates/instructions/src/transaction.rs",
        "crates/instructions/Cargo.toml",
        "crates/instructions/Cargo.lock",
        "assets/instructions/catalog.json",
        "assets/instructions/default-manifest.json"
      ],
      "tests": [
        "instructions-tests"
      ],
      "reason": "Explicit rule composition, translations, output ownership, preservation, migration and publication; embedded portable defaults"
    },
    {
      "id": "registration-judge",
      "paths": [
        "crates/judge-registration/src/lib.rs",
        "crates/judge-registration/src/schema.rs",
        "crates/judge-registration/src/main.rs",
        "crates/judge-registration/Cargo.toml",
        "crates/judge-registration/Cargo.lock",
        "crates/judge-registration/src/registrations.rs",
        "crates/judge-registration/src/execution.rs",
        "crates/judge-registration/src/inputs.rs",
        "crates/judge-registration/src/transition.rs"
      ],
      "tests": [
        "judge-registration-tests"
      ],
      "reason": "Registration schema, snapshot and reference policy"
    },
    {
      "id": "filemap-impact",
      "paths": [
        "crates/judge-filemap/Cargo.toml",
        "crates/judge-filemap/Cargo.lock",
        "crates/judge-filemap/src/lib.rs",
        "crates/judge-filemap/src/main.rs",
        "crates/judge-filemap/src/graph.rs",
        "crates/judge-filemap/src/records.rs",
        "crates/judge-filemap/src/workflow.rs"
      ],
      "tests": [
        "judge-filemap-tests",
        "judge-ci-tests"
      ],
      "reason": "Full declaration impact and shared operational CI closure selection"
    },
    {
      "id": "judge-routes",
      "paths": [
        "crates/judge-routes/Cargo.toml",
        "crates/judge-routes/Cargo.lock",
        "crates/judge-routes/src/lib.rs",
        "crates/judge-routes/src/main.rs"
      ],
      "tests": [
        "judge-routes-tests"
      ],
      "reason": "Registered method/receipt and paired operation execution policy"
    },
    {
      "id": "judge-projects",
      "paths": [
        "crates/judge-projects/Cargo.toml",
        "crates/judge-projects/Cargo.lock",
        "crates/judge-projects/src/lib.rs",
        "crates/judge-projects/src/main.rs"
      ],
      "tests": [
        "judge-projects-tests"
      ],
      "reason": "Registered method/receipt and paired operation execution policy"
    },
    {
      "id": "declared-costs",
      "paths": [
        "crates/judge-cost/Cargo.toml",
        "crates/judge-cost/Cargo.lock",
        "crates/judge-cost/src/lib.rs",
        "crates/judge-cost/src/main.rs"
      ],
      "tests": [
        "judge-cost-tests"
      ],
      "reason": "Four-coordinate cost reporting, endpoint provenance and warning/error semantics"
    },
    {
      "id": "mixed-classification",
      "paths": [
        "crates/judge-mixed/Cargo.toml",
        "crates/judge-mixed/Cargo.lock",
        "crates/judge-mixed/src/lib.rs",
        "crates/judge-mixed/src/main.rs",
        "crates/judge-mixed/src/semantic.rs"
      ],
      "tests": [
        "judge-mixed-tests"
      ],
      "reason": "Explicit surface and semantic-field changes, mixed warnings and bound cost provenance"
    },
    {
      "id": "workflow-certification",
      "paths": [
        "crates/judge-workflow/Cargo.toml",
        "crates/judge-workflow/Cargo.lock",
        "crates/judge-workflow/src/lib.rs",
        "crates/judge-workflow/src/main.rs",
        "crates/judge-workflow/src/branch.rs",
        "crates/judge-workflow/src/evidence.rs",
        "crates/judge-workflow/src/transition.rs",
        "crates/judge-workflow/src/certificate.rs"
      ],
      "tests": [
        "judge-workflow-tests",
        "workflow-units",
        "workflow-short"
      ],
      "reason": "Branch freshness, declared evolution and actual integration evidence"
    },
    {
      "id": "retained-inputs",
      "paths": [
        "crates/inputs/Cargo.toml",
        "crates/inputs/Cargo.lock",
        "crates/inputs/src/lib.rs",
        "crates/inputs/src/main.rs"
      ],
      "tests": [
        "inputs-tests"
      ],
      "reason": "Explicit input snapshots and retained content transport"
    },
    {
      "id": "distribution",
      "paths": [
        "crates/distribution/Cargo.toml",
        "crates/distribution/Cargo.lock",
        "crates/distribution/src/lib.rs",
        "crates/distribution/src/main.rs",
        "assets/distribution/bootstrap.sh",
        ".chrono-harness/release/plan.json",
        ".chrono-harness/release/build.json",
        ".chrono-harness/release/build.py",
        ".github/workflows/chrono-release.yml"
      ],
      "tests": [
        "distribution-tests"
      ],
      "reason": "Release identity, pinned installation, bootstrap and update rollback"
    },
    {
      "id": "worktree-creation",
      "paths": [
        "crates/worktree/Cargo.toml",
        "crates/worktree/Cargo.lock",
        "crates/worktree/src/lib.rs",
        "crates/worktree/src/main.rs",
        "crates/worktree/src/start.rs",
        "crates/worktree/src/reconstruct.rs",
        ".chrono-harness/worktree.json",
        "crates/worktree/src/remote.rs",
        "crates/worktree/src/maintenance.rs",
        "crates/worktree/src/recovery.rs",
        "crates/worktree/src/fetch_recovery.rs",
        "crates/worktree/src/rebind.rs",
        "crates/worktree/src/rebind_inputs.rs",
        "crates/worktree/src/automatic.rs",
        "crates/worktree/src/automatic/migration.rs"
      ],
      "tests": [
        "worktree-tests"
      ],
      "reason": "Explicit worktree creation, reconstruction, recovery, metadata rebind and retirement with original process observations and work preservation"
    },
    {
      "id": "ci-projections",
      "paths": [
        "crates/ci/src/lib.rs",
        "crates/ci/src/release.rs",
        ".chrono-harness/ci/release.json",
        "crates/ci/src/full.rs"
      ],
      "tests": [
        "ci-tests",
        "judge-workflow-tests",
        "workflow-units",
        "workflow-short"
      ],
      "reason": "Explicit check/release source dispatch, shared output ownership and native workflow generation"
    },
    {
      "id": "standard-diagnostics",
      "paths": [
        "crates/diagnostics/Cargo.toml",
        "crates/diagnostics/Cargo.lock",
        "crates/diagnostics/src/lib.rs",
        "crates/diagnostics/src/error.rs",
        "crates/diagnostics/src/logging.rs"
      ],
      "tests": [
        "diagnostics-tests",
        "runner-tests"
      ],
      "reason": "Structured log records, explicit typed error chains and CLI channel preservation"
    },
    {
      "id": "cache-planning",
      "paths": [
        "crates/cache/Cargo.toml",
        "crates/cache/Cargo.lock",
        "crates/cache/src/lib.rs",
        "crates/cache/src/main.rs"
      ],
      "tests": [
        "cache-tests"
      ],
      "reason": "Explicit cache consumers, artifact ownership and input compatibility"
    }
  ],
  "semantic_changes_require_integration": true,
  "mixed_change": {
    "level": "warning",
    "code": "W_MIXED_JUDGE_PRODUCT",
    "requires_acknowledgement": false
  },
  "integration": {
    "tests": [
      "identifiers-tests",
      "runner-tests",
      "instructions-tests",
      "judge-registration-tests",
      "judge-filemap-tests",
      "judge-routes-tests",
      "judge-projects-tests",
      "judge-cost-tests",
      "judge-mixed-tests",
      "judge-workflow-tests",
      "inputs-tests",
      "distribution-tests",
      "worktree-tests",
      "workflow-units",
      "workflow-short",
      "diagnostics-tests"
    ],
    "bind": [
      "base",
      "candidate_tree",
      "registry_digest",
      "executables",
      "tools",
      "environment",
      "effective_inputs",
      "required_tests",
      "results_digest"
    ],
    "evidence": ".chrono-harness/state/integration.json"
  },
  "retirements": [
    {
      "kind": "script",
      "id": "scoped-v1",
      "replacement": null,
      "reason": "Retire the fixed historical scoped host decoder and its dedicated tests; current hosts use the current specification without historical support."
    },
    {
      "kind": "test",
      "id": "scoped-v1-tests",
      "replacement": null,
      "reason": "Joint retirement with scoped-v1; the obsolete host conversion is no longer a supported operation."
    },
    {
      "kind": "test",
      "id": "judge-projects-migration",
      "replacement": "judge-projects-tests",
      "reason": "Retire fixed historical-host support and its tests. The remaining current projects contract runs through its original unfiltered dedicated test action; this replacement does not claim preservation of the retired historical assertions."
    },
    {
      "kind": "script",
      "id": "artifact-members",
      "replacement": null,
      "reason": "Retire per-member HTTP range transport; the current artifact consumer uses the existing GitHub CLI download with cumulative acquisition budgets and original evidence validation."
    },
    {
      "kind": "test",
      "id": "artifact-members-tests",
      "replacement": null,
      "reason": "Joint retirement with artifact-members and its dedicated ZIP fixture; range transport is no longer a supported operation. Existing Rust collection tests preserve original report, stream, identity, retry and budget acceptance."
    },
    {
      "kind": "script",
      "id": "workflow-inventory",
      "replacement": null,
      "reason": "The explicit libtest inventory validator is implemented by chrono-ci test-inventory; current workflow and worktree actions use the Rust owner."
    },
    {
      "kind": "test",
      "id": "workflow-inventory-tests",
      "replacement": "ci-tests",
      "reason": "Rust paired tests preserve explicit group coverage, malformed listings and original subprocess failures. Python import/bytecode assertions retire with the removed Python implementation."
    },
    {
      "kind": "script",
      "id": "ci-native-adapter",
      "replacement": null,
      "reason": "原生 CI 上下文与证据转交已迁入 chrono-ci，退役 Python 适配器和跨语言进程桥。"
    },
    {
      "kind": "test",
      "id": "ci-native-adapter-tests",
      "replacement": "ci-tests",
      "reason": "原专属测试的纳秒时间边界、原始字节、工具解析、凭据省略、非零退出、超时和输出上限由 ci-tests 的 native Rust 测试覆盖；full-short 保留真实发布、获取、转交及汇总集成验证。"
    },
    {
      "kind": "project",
      "id": "judge-cargo",
      "replacement": null,
      "reason": "没有当前终端使用方；删除仅由自有合成测试调用的 Cargo 保护适配器。普通 Cargo 构建和通用输入完整性合同继续保留。"
    },
    {
      "kind": "test",
      "id": "judge-cargo-tests",
      "replacement": null,
      "reason": "与 judge-cargo 同时退役，其 guard／metadata 专属行为不再作为当前支持接口。保留其他项目的真实构建和未过滤行为测试；不宣称它们替代被删除的断言。"
    }
  ],
  "migrations": [],
  "historical_profiles": []
}
