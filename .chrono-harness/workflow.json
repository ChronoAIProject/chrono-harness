  "semantic_changes_require_integration": true,
  "mixed_change": {
    "level": "warning",
    "code": "W_MIXED_JUDGE_PRODUCT",
    "requires_acknowledgement": false
  },
  "integration": {
    "tests": [
      "runner-tests",
      "instructions-tests",
      "judge-registration-tests",
      "judge-filemap-tests",
      "judge-routes-tests",
      "judge-projects-tests",
      "judge-cost-tests",
      "judge-mixed-tests",
      "judge-workflow-tests",
      "inputs-tests",
      "distribution-tests",
      "judge-cargo-tests",
      "worktree-tests",
      "workflow-units",
      "workflow-short",
      "diagnostics-tests"
    ],
    "bind": [
      "base",
      "candidate_tree",
      "registry_digest",
      "executables",
      "tools",
      "environment",
      "effective_inputs",
      "required_tests",
      "results_digest"
    ],
    "evidence": ".chrono-harness/state/integration.json"
  },
  "retirements": [
    {
      "kind": "test",
      "id": "ci-verify",
      "replacement": "ci-tests",
      "reason": "ci.verify belongs to ci and the complete ci-tests plan; historical method replacement explicitly binds its current provider."
    },
    {
      "kind": "script",
      "id": "ci-verify",
      "replacement": "ci",
      "reason": "Retire malformed pseudo-script; actual ci method owns execution."
    }
  ],
  "migrations": [
    {
      "from_version": 1,
      "to_version": 2,
      "script": "scoped-v1",
      "test": "scoped-v1-tests",
      "mappings": [
        {
          "from": "script:ci-verify",
          "to": "project:ci"
        },
        {
          "from": "test:ci-verify",
          "to": "test:ci-tests"
        },
        {
          "from": "owner:ci-verify",
          "to": "owner:ci"
        }
      ],
      "reason": "Finite historical chrono-ci-check/v1 binding decoder; workflow certification remains unresolved."
    }
  ],
  "historical_profiles": [
    {
      "id": "chrono-ci-check/v1",
      "filemap_version": 1,
      "profile_path": ".chrono-harness/ci/check.json",
      "script": "scoped-v1",
      "test": "scoped-v1-tests",
      "mappings": [
        {
          "from": "script:ci-verify",
          "to": "project:ci"
        },
        {
          "from": "test:ci-verify",
          "to": "test:ci-tests"
        },
        {
          "from": "owner:ci-verify",
          "to": "owner:ci"
        }
      ],
      "legacy_records": [
        {
          "collection": "scripts",
          "id": "ci-verify",
          "definition": {
            "id": "ci-verify",
            "kind": "test",
            "actions": {
              "execute": {
                "operation": "ci.verify",
                "tool": "chrono-ci",
                "argv": [
                  "verify",
                  "--host-root",
                  ".",
                  "--config",
                  ".chrono-harness/ci/github.json"
                ]
              }
            }
          },
          "nodes": [
            "script:ci-verify",
            "test:ci-verify"
          ]
        }
      ],
      "ambiguities": [],
      "method_replacements": [
        {
          "from": {
            "owner": "script:ci-verify",
            "operation": "ci.verify",
            "tool": "chrono-ci",
            "argv": [
              "verify",
              "--host-root",
              ".",
              "--config",
              ".chrono-harness/ci/github.json"
            ]
          },
          "to": {
            "owner": "project:ci",
            "operation": "ci.verify",
            "tool": "chrono-ci",
            "argv": [
              "verify",
              "--host-root",
              ".",
              "--config",
              ".chrono-harness/ci/units.json"
            ]
          },
          "reason": "Preserve the ci.verify operation and complete ci-tests plan while explicitly adopting the independent-unit provider."
        }
      ]
    }
  ]
