{
  "schema": "chrono-bootstrap/v1",
  "projects": ".chrono-harness/projects.json",
  "rust_toolchain": "1.95.0",
  "tools": {
    "python3": "/usr/bin/python3"
  },
  "operations": [
    "host.verus-download",
    "host.verus-checksum",
    "host.verus-extract"
  ],
  "verus": {
    "cache_directory": ".chrono-harness/cache/bootstrap-verus",
    "install_directory": ".chrono-harness/bin/verus",
    "platforms": {
      "Darwin/arm64": {
        "version": "0.2026.04.24.f8e1704",
        "url": "https://github.com/verus-lang/verus/releases/download/release/0.2026.04.24.f8e1704/verus-0.2026.04.24.f8e1704-arm64-macos.zip",
        "archive": "verus-0.2026.04.24.f8e1704-arm64-macos.zip",
        "sha256": "023e0a6e67bb9927f43a8757ebdec318b50cbfe1fec4a1c320c53d5fd71008e7"
      }
    }
  },
  "install": [],
  "participation": {
    "coordinator_root": "git-main-worktree",
    "program": ".chrono-harness/bin/chrono-worktree",
    "git": "/usr/bin/git",
    "config": ".chrono-harness/worktree.json"
  },
  "entrypoint": {
    "tool": "python3",
    "script": ".chrono-harness/ci/bootstrap.py"
  },
  "require_tool_bindings": true,
  "tool_bindings_registry": ".chrono-harness/ci/bootstrap-toolchains.json",
  "report_path": ".chrono-harness/state/verus-bootstrap.json"
}
