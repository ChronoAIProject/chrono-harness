{
  "schema": "chrono-ci-check/v1",
  "judge": {
    "program": ".chrono-harness/bin/chrono-judge-ci",
    "args": [],
    "timeout_seconds": 2400,
    "output_limit_bytes": 8388608
  },
  "report_path": ".chrono-harness/state/check.json",
  "policy": {
    "filemap": ".chrono-harness/FILEMAP.json",
    "projects": ".chrono-harness/projects.json",
    "tools": {
      "cargo": "cargo",
      "chrono-ci": ".chrono-harness/bin/chrono-ci",
      "python3": "/usr/bin/python3"
    },
    "artifacts": [
      ".chrono-harness/bin/",
      ".chrono-harness/state/",
      "crates/runner/target/",
      "crates/runner-tests/target/",
      "crates/instructions/target/",
      "crates/instructions-tests/target/",
      "crates/judge-ci/target/",
      "crates/judge-ci-tests/target/",
      "crates/ci/target/",
      "crates/ci-tests/target/",
      "crates/judge-registration/target/",
      "crates/judge-registration-tests/target/",
      "crates/judge-filemap/target/",
      "crates/judge-filemap-tests/target/",
      "crates/judge-routes/target/",
      "crates/judge-routes-tests/target/",
      "crates/judge-projects/target/",
      "crates/judge-projects-tests/target/",
      "crates/judge-cost/target/",
      "crates/judge-cost-tests/target/",
      "crates/judge-mixed/target/",
      "crates/judge-mixed-tests/target/",
      "crates/judge-workflow/target/",
      "crates/judge-workflow-tests/target/",
      "crates/inputs/target/",
      "crates/inputs-tests/target/"
    ],
    "required_inputs": [
      ".chrono-harness/ci/check.json",
      ".chrono-harness/ci/github.json",
      ".chrono-harness/ci/bootstrap.py",
      ".chrono-harness/ci/bootstrap.json",
      ".github/workflows/chrono-ci.yml"
    ],
    "adoption_base": "c4536e5c35d06302cdec655b3f11f9c257919155",
    "operation_timeout_seconds": 600,
    "operation_output_limit_bytes": 1048576,
    "environment": {
      "RUSTUP_TOOLCHAIN": "1.95.0",
      "CARGO_TERM_COLOR": "never"
    },
    "registration_config": ".chrono-harness/config.json"
  }
}
