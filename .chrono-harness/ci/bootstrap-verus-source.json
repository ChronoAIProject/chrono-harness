{
  "schema": "chrono-bootstrap/v1",
  "projects": ".chrono-harness/projects.json",
  "rust_toolchain": "1.99.1",
  "tools": {
    "tar": "/usr/bin/tar",
    "bootstrap-native": ".chrono-harness/bin/chrono-host-bootstrap"
  },
  "operations": [
    "investigate.verus-source.z3-download",
    "investigate.verus-source.z3-extract",
    "investigate.verus-source.build",
    "investigate.verus-source.version",
    "investigate.verus-source.dependencies",
    "investigate.verus-source.vstd"
  ],
  "install": [],
  "participation": {
    "coordinator_root": "git-main-worktree",
    "program": ".chrono-harness/bin/chrono-worktree",
    "git": "/usr/bin/git",
    "config": ".chrono-harness/worktree.json"
  },
  "entrypoint": {
    "tool": "bash",
    "script": ".chrono-harness/ci/bootstrap-native.sh"
  },
  "require_tool_bindings": true,
  "tool_bindings_registry": ".chrono-harness/ci/verus-source-toolchains.json",
  "report_path": ".chrono-harness/state/verus-source-bootstrap.json",
  "rust_incremental": true,
  "environment": {
    "RUSTC_BOOTSTRAP": "1"
  },
  "host_environment": {
    "CARGO_HOME": ".chrono-harness/cache/bootstrap-owner-tooling/cargo",
    "TMPDIR": ".chrono-harness/cache/bootstrap-owner-tooling/tmp"
  }
}
