{
  "schema": "chrono-bootstrap/v1",
  "projects": ".chrono-harness/projects.json",
  "rust_toolchain": "1.95.0",
  "tools": {},
  "operations": [
    "inputs.fetch.worktree",
    "build.worktree"
  ],
  "install": [],
  "participation": {
    "coordinator_root": "git-main-worktree",
    "program": ".chrono-harness/bin/chrono-worktree",
    "git": "/usr/bin/git",
    "config": ".chrono-harness/worktree.json"
  },
  "entrypoint": {
    "tool": "python3",
    "script": ".chrono-harness/ci/bootstrap.py"
  },
  "rust_incremental": true,
  "require_tool_bindings": true,
  "tool_bindings_registry": ".chrono-harness/ci/bootstrap-toolchains.json",
  "report_path": ".chrono-harness/state/bootstrap-owner-stage.json",
  "owner_stage": {
    "source": "crates/worktree/target/debug/chrono-worktree",
    "selected": ".chrono-harness/bin/chrono-worktree"
  },
  "host_environment": {
    "TMPDIR": ".chrono-harness/state/bootstrap-owner-tooling/tmp",
    "CARGO_HOME": ".chrono-harness/state/bootstrap-owner-tooling/cargo",
    "HOME": ".chrono-harness/state/bootstrap-owner-tooling/home"
  },
  "environment": {
    "CARGO_NET_OFFLINE": "false"
  }
}
