{
  "schema": "chrono-bootstrap/v1",
  "projects": ".chrono-harness/projects.json",
  "rust_toolchain": "1.95.0",
  "tools": {},
  "operations": ["build.host-bootstrap-native"],
  "install": [
    {
      "source": ".chrono-harness/cache/host-bootstrap-native/target/debug/chrono-host-bootstrap",
      "destination": ".chrono-harness/bin/chrono-host-bootstrap"
    }
  ],
  "participation": {
    "coordinator_root": "git-main-worktree",
    "program": ".chrono-harness/bin/chrono-worktree",
    "git": "/usr/bin/git",
    "config": ".chrono-harness/worktree.json"
  },
  "entrypoint": {
    "tool": "bash",
    "script": ".chrono-harness/ci/bootstrap-native.sh"
  },
  "require_tool_bindings": true,
  "tool_bindings_registry": ".chrono-harness/ci/bootstrap-toolchains.json",
  "report_path": ".chrono-harness/state/bootstrap-frontend.json",
  "host_environment": {
    "TMPDIR": ".chrono-harness/cache/bootstrap-owner-tooling/tmp",
    "CARGO_HOME": ".chrono-harness/cache/bootstrap-owner-tooling/cargo",
    "HOME": ".chrono-harness/cache/bootstrap-owner-tooling/home"
  },
  "environment": {"CARGO_NET_OFFLINE": "false"}
}
