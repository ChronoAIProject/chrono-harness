    "context_path": ".chrono-harness/state/native/macos/local/context.json",
    "collection_manifest": ".chrono-harness/state/native/macos/collection/manifest.json",
    "roles": {
      "feature": "integration",
      "integration": "integration"
    },
    "full_inputs": {
      "retained_inputs": ".chrono-harness/state/native/macos/inputs/full.json"
    }
  },
  "automatic_cleanup": ".chrono-harness/native/macos/cleanup.json"
}
