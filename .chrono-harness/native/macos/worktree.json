{
  "schema": "chrono-worktree-config/v2",
  "host_config": ".chrono-harness/config.json",
  "remote": "origin",
  "git": {
    "program": "/usr/bin/git",
    "expected_version": "git version 2.39.3 (Apple Git-146)",
    "sha256": "4016687c36d60a2bbcab1de3850ebdafdd0a95f9421ff7f05aaf4ca6a002a227"
  },
  "environment": {
    "inherit": [
      "PATH",
      "HOME",
      "SSH_AUTH_SOCK"
    ],
    "values": {
      "GIT_TERMINAL_PROMPT": "0"
    }
  },
  "timeout_seconds": 120,
  "output_limit_bytes": 1048576,
  "immutable_input_limits": {
    ".chrono-harness/FILEMAP.json": 2097152,
    ".chrono-harness/local-config.json": 2097152,
    ".chrono-harness/ci/scoped-macos.json": 2097152,
    ".chrono-harness/ci/scoped-linux.json": 2097152
  },
  "report_directory": ".chrono-harness/state/native/macos/worktrees/",
