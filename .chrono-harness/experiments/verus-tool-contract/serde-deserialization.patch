+test_verify_one_file_with_options! {
+    #[test] serde_deserialize_rejects_wrong_local_implementation
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, Deserializer};
+        struct Wrong;
+        impl<'de> Deserialize<'de> for Wrong {
+            fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+                assert(false); // FAILS
+                match bool::deserialize(d) {
+                    Ok(_) => Ok(Wrong),
+                    Err(error) => Err(error),
+                }
+            }
+        }
+    } => Err(err) => {
+        assert!(err.errors[0].message.contains("assertion failed"));
+        assert_one_fails(err);
+    }
+}
