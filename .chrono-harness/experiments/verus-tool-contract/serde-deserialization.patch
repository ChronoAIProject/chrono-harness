+        use serde::de::{Deserialize, Deserializer, Visitor, Error};
+
+        struct Flag { value: bool }
+        struct FlagVisitor;
+        impl<'de> Visitor<'de> for FlagVisitor {
+            type Value = Flag;
+            fn expecting(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("boolean")
+            }
