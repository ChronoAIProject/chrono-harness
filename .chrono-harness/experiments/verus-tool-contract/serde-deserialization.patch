+test_verify_one_file_with_options! {
+    #[test] serde_deserialize_checks_local_implementation_and_real_derives
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, Deserializer, Visitor, Error};
+
+        struct Flag { value: bool }
+        struct FlagVisitor;
+        impl<'de> Visitor<'de> for FlagVisitor {
+            type Value = Flag;
+            fn expecting(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("boolean")
+            }
+            fn visit_bool<E: Error>(self, value: bool) -> Result<Flag, E> {
+                Ok(Flag { value })
+            }
+        }
+        impl<'de> Deserialize<'de> for Flag {
+            fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+                d.deserialize_bool(FlagVisitor)
+            }
+        }
+        #[derive(serde::Deserialize)]
+        struct Record { count: u64, flag: bool }
+        #[derive(serde::Deserialize)]
+        enum Choice { Unit, Tuple(u64), Record { flag: bool } }
+        fn forward<'de, D: Deserializer<'de>>(d: D) -> Result<Record, D::Error> {
+            Record::deserialize(d)
+        }
+    } => Ok(())
+}
