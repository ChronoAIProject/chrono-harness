+        fn tuple<'de, A: VariantAccess<'de>, V: Visitor<'de>>(a: A, len: usize, v: V)
+            -> Result<V::Value, A::Error> { a.tuple_variant(len, v) }
+        fn record<'de, A: VariantAccess<'de>, V: Visitor<'de>>(a: A, fields: &'static [&'static str], v: V)
+            -> Result<V::Value, A::Error> { a.struct_variant(fields, v) }
+        fn in_place<'de, D: Deserializer<'de>, T: Deserialize<'de>>(d: D, place: &mut T)
+            -> Result<(), D::Error> { T::deserialize_in_place(d, place) }
+    } => Ok(())
+}
