+                Ok(Flag { value })
+            }
+        }
+        impl<'de> Deserialize<'de> for Flag {
+            fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+                d.deserialize_bool(FlagVisitor)
+            }
+        }
+        #[derive(serde::Deserialize)]
+        struct Record { count: u64, flag: bool }
+        #[derive(serde::Deserialize)]
+        enum Choice { Unit, Tuple(u64), Record { flag: bool } }
+        fn forward<'de, D: Deserializer<'de>>(d: D) -> Result<Record, D::Error> {
+            Record::deserialize(d)
+        }
+    } => Ok(())
