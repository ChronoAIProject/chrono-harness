+test_verify_one_file_with_options! {
+    #[test] serde_visitor_forwards_borrowed_owned_and_compound_arguments
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Error, Deserializer, Visitor, SeqAccess, MapAccess, EnumAccess};
+
+        fn boolean<'de, V: Visitor<'de>, E: Error>(v: V, b: bool) -> Result<V::Value, E> { v.visit_bool(b) }
+        fn signed<'de, V: Visitor<'de>, E: Error>(v: V, n: i128) -> Result<V::Value, E> { v.visit_i128(n) }
+        fn unsigned<'de, V: Visitor<'de>, E: Error>(v: V, n: u128) -> Result<V::Value, E> { v.visit_u128(n) }
+        fn float<'de, V: Visitor<'de>, E: Error>(v: V, n: f64) -> Result<V::Value, E> { v.visit_f64(n) }
+        fn character<'de, V: Visitor<'de>, E: Error>(v: V, c: char) -> Result<V::Value, E> { v.visit_char(c) }
+        fn text<'de, V: Visitor<'de>, E: Error>(v: V, s: &str) -> Result<V::Value, E> { v.visit_str(s) }
+        fn borrowed_text<'de, V: Visitor<'de>, E: Error>(v: V, s: &'de str) -> Result<V::Value, E> { v.visit_borrowed_str(s) }
+        fn owned_text<'de, V: Visitor<'de>, E: Error>(v: V, s: String) -> Result<V::Value, E> { v.visit_string(s) }
+        fn bytes<'de, V: Visitor<'de>, E: Error>(v: V, s: &[u8]) -> Result<V::Value, E> { v.visit_bytes(s) }
+        fn borrowed_bytes<'de, V: Visitor<'de>, E: Error>(v: V, s: &'de [u8]) -> Result<V::Value, E> { v.visit_borrowed_bytes(s) }
+        fn owned_bytes<'de, V: Visitor<'de>, E: Error>(v: V, s: Vec<u8>) -> Result<V::Value, E> { v.visit_byte_buf(s) }
+        fn none<'de, V: Visitor<'de>, E: Error>(v: V) -> Result<V::Value, E> { v.visit_none() }
+        fn unit<'de, V: Visitor<'de>, E: Error>(v: V) -> Result<V::Value, E> { v.visit_unit() }
+        fn some<'de, V: Visitor<'de>, D: Deserializer<'de>>(v: V, d: D) -> Result<V::Value, D::Error> { v.visit_some(d) }
+        fn newtype<'de, V: Visitor<'de>, D: Deserializer<'de>>(v: V, d: D) -> Result<V::Value, D::Error> { v.visit_newtype_struct(d) }
+        fn sequence<'de, V: Visitor<'de>, A: SeqAccess<'de>>(v: V, a: A) -> Result<V::Value, A::Error> { v.visit_seq(a) }
+        fn map<'de, V: Visitor<'de>, A: MapAccess<'de>>(v: V, a: A) -> Result<V::Value, A::Error> { v.visit_map(a) }
+        fn choice<'de, V: Visitor<'de>, A: EnumAccess<'de>>(v: V, a: A) -> Result<V::Value, A::Error> { v.visit_enum(a) }
+    } => Ok(())
+}
