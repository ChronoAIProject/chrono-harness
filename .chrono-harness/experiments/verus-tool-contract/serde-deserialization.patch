+test_verify_one_file_with_options! {
+    #[test] serde_visitor_forbids_impl_postconditions_on_recursive_exec_interface
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, Deserializer, Visitor};
+        struct Wrong;
+        impl<'de> Visitor<'de> for Wrong {
+            type Value = bool;
+            fn expecting(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("boolean")
+            }
+            fn visit_some<D: Deserializer<'de>>(self, d: D) -> (result: Result<bool, D::Error>)
+                ensures result is Ok,
+            {
+                bool::deserialize(d)
+            }
+        }
+    } => Err(err) => assert_vir_error_msg(err,
+        "trait method implementation cannot declare `ensures` clauses because the trait declaration is marked `impls_cannot_extend_spec`")
+}
