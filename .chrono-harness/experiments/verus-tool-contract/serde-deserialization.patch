+test_verify_one_file_with_options! {
+    #[test] serde_access_keeps_seed_values_and_original_error_types
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, DeserializeSeed, Deserializer, Visitor,
+            SeqAccess, MapAccess, EnumAccess, VariantAccess};
+
+        fn seed<'de, S: DeserializeSeed<'de>, D: Deserializer<'de>>(s: S, d: D)
+            -> Result<S::Value, D::Error> { s.deserialize(d) }
+        fn element_seed<'de, A: SeqAccess<'de>, T: DeserializeSeed<'de>>(a: &mut A, s: T)
+            -> Result<Option<T::Value>, A::Error> { a.next_element_seed(s) }
+        fn element<'de, A: SeqAccess<'de>, T: Deserialize<'de>>(a: &mut A)
+            -> Result<Option<T>, A::Error> { a.next_element() }
+        fn seq_hint<'de, A: SeqAccess<'de>>(a: &A) -> Option<usize> { a.size_hint() }
+        fn key_seed<'de, A: MapAccess<'de>, K: DeserializeSeed<'de>>(a: &mut A, k: K)
+            -> Result<Option<K::Value>, A::Error> { a.next_key_seed(k) }
+        fn value_seed<'de, A: MapAccess<'de>, V: DeserializeSeed<'de>>(a: &mut A, v: V)
+            -> Result<V::Value, A::Error> { a.next_value_seed(v) }
+        fn entry_seed<'de, A: MapAccess<'de>, K: DeserializeSeed<'de>, V: DeserializeSeed<'de>>(a: &mut A, k: K, v: V)
+            -> Result<Option<(K::Value, V::Value)>, A::Error> { a.next_entry_seed(k, v) }
+        fn key<'de, A: MapAccess<'de>, K: Deserialize<'de>>(a: &mut A)
+            -> Result<Option<K>, A::Error> { a.next_key() }
+        fn value<'de, A: MapAccess<'de>, V: Deserialize<'de>>(a: &mut A)
+            -> Result<V, A::Error> { a.next_value() }
+        fn entry<'de, A: MapAccess<'de>, K: Deserialize<'de>, V: Deserialize<'de>>(a: &mut A)
+            -> Result<Option<(K, V)>, A::Error> { a.next_entry() }
+        fn map_hint<'de, A: MapAccess<'de>>(a: &A) -> Option<usize> { a.size_hint() }
+        fn variant_seed<'de, A: EnumAccess<'de>, V: DeserializeSeed<'de>>(a: A, v: V)
+            -> Result<(V::Value, A::Variant), A::Error> { a.variant_seed(v) }
+        fn variant<'de, A: EnumAccess<'de>, V: Deserialize<'de>>(a: A)
+            -> Result<(V, A::Variant), A::Error> { a.variant() }
+        fn unit<'de, A: VariantAccess<'de>>(a: A) -> Result<(), A::Error> { a.unit_variant() }
+        fn newtype_seed<'de, A: VariantAccess<'de>, T: DeserializeSeed<'de>>(a: A, s: T)
+            -> Result<T::Value, A::Error> { a.newtype_variant_seed(s) }
+        fn newtype<'de, A: VariantAccess<'de>, T: Deserialize<'de>>(a: A)
+            -> Result<T, A::Error> { a.newtype_variant() }
+        fn tuple<'de, A: VariantAccess<'de>, V: Visitor<'de>>(a: A, len: usize, v: V)
+            -> Result<V::Value, A::Error> { a.tuple_variant(len, v) }
+        fn record<'de, A: VariantAccess<'de>, V: Visitor<'de>>(a: A, fields: &'static [&'static str], v: V)
+            -> Result<V::Value, A::Error> { a.struct_variant(fields, v) }
+        fn in_place<'de, D: Deserializer<'de>, T: Deserialize<'de>>(d: D, place: &mut T)
+            -> Result<(), D::Error> { T::deserialize_in_place(d, place) }
+    } => Ok(())
+}
