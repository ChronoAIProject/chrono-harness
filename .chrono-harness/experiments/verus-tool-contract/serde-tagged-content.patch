+test_verify_one_file_with_options! {
+    #[test] serde_tagged_content_does_not_assume_deserialization_success
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, Error};
+        use serde::__private229::de::{Content, ContentDeserializer};
