+test_verify_one_file_with_options! {
+    #[test] serde_tagged_content_forwards_original_visitor_and_deserializer_parameters
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::{Deserialize, Deserializer, Error};
+        use serde::__private229::de::{Content, ContentDeserializer, TaggedContentVisitor};
+
+        fn tagged<'de, T: Deserialize<'de>, D: Deserializer<'de>>(
+            deserializer: D, name: &'static str, expecting: &'static str,
+        ) -> Result<(T, Content<'de>), D::Error> {
+            deserializer.deserialize_any(TaggedContentVisitor::<T>::new(name, expecting))
+        }
+
+        fn buffered<'de, T: Deserialize<'de>, E: Error>(content: Content<'de>) -> Result<T, E> {
+            T::deserialize(ContentDeserializer::<E>::new(content))
+        }
+    } => Ok(())
+}
+
+test_verify_one_file_with_options! {
+    #[test] serde_tagged_content_rejects_a_changed_field
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::__private229::de::Content;
+        fn wrong() {
+            let c = Content::U8(7);
+            assert(match c { Content::U8(v) => v == 8, _ => false }); // FAILS
+        }
+    } => Err(err) => {
+        assert!(err.errors[0].message.contains("assertion failed"));
+        assert_one_fails(err);
+    }
+}
