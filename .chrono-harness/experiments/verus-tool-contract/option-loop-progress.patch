+test_verify_one_file_with_options! {
+    #[test] option_slots_prove_each_back_edge_fills_a_new_slot
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        fn fill() {
+            let mut first: Option<u64> = None;
+            let mut second: Option<u64> = None;
+            loop {
+                if first.is_none() { first = Some(7); continue; }
+                if second.is_none() { second = Some(11); continue; }
+                break;
+            }
+        }
+    } => Ok(())
+}
