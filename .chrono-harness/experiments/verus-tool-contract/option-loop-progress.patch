 /// corresponds to the one that is intended for any source
 /// code that the syntax macro might emit.
 /// (After this point, we use the Label to identify the loop.)
+/// Supply a candidate ranking function, never a termination assumption.
+/// Only Option locals declared outside this body participate. The ordinary
+/// loop checker must still prove that every back edge decreases the sum.
+fn infer_option_loop_decrease(
+    bctx: &BodyCtxt<'_>,
+    body: &vir::ast::Expr,
+    span: Span,
+) -> Result<vir::ast::Exprs, VirErr> {
+    let mut slots: Vec<(VarIdent, Typ, Dt)> = Vec::new();
+    vir::ast_visitor::expr_visitor_check(body, &mut |scope, expr| {
+        if let ExprX::Assign { place, .. } = &expr.x {
+            if let PlaceX::Local(local) = &place.x {
+                if scope.get(local).is_none()
+                    && !slots.iter().any(|(name, _, _)| name == local)
+                {
+                    if let TypX::Datatype(Dt::Path(path), _, _) = &*place.typ {
+                        if path.krate == CrateId::Core
+                            && path.segments.len() == 2
+                            && path.segments[0].is_name("option")
+                            && path.segments[1].is_name("Option")
+                        {
+                            slots.push((local.clone(), place.typ.clone(), Dt::Path(path.clone())));
+                        }
+                    }
+                }
+            }
+        }
+        Ok::<(), VirErr>(())
+    })?;
+    if slots.is_empty() {
+        return Ok(Arc::new(vec![]));
+    }
+    let int_typ = vir::ast_util::int_typ();
+    let zero = bctx.spanned_typed_new(span, &int_typ, ExprX::Const(vir::ast_util::const_int_from_usize(0)));
+    let one = bctx.spanned_typed_new(span, &int_typ, ExprX::Const(vir::ast_util::const_int_from_usize(1)));
+    let mut sum = zero.clone();
+    for (local, typ, datatype) in slots {
+        let value = bctx.spanned_typed_new(span, &typ, ExprX::Var(local));
+        bctx.erasure_info.borrow_mut().local_hir_vir_ids.push((None, value.span.id));
+        let vacant = bctx.spanned_typed_new(
+            span, &bool_typ(),
+            ExprX::UnaryOpr(UnaryOpr::IsVariant { datatype, variant: str_ident("None") }, value),
+        );
+        let count = bctx.spanned_typed_new(
+            span, &int_typ, ExprX::If(vacant, one.clone(), Some(zero.clone())),
+        );
+        sum = bctx.spanned_typed_new(
+            span, &int_typ,
+            ExprX::Binary(BinaryOp::Arith(ArithOp::Add(OverflowBehavior::Allow)), sum, count),
+        );
+    }
+    Ok(Arc::new(vec![sum]))
+}
