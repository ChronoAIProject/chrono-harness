+test_verify_one_file_with_options! {
+    #[test] serde_unexpected_rejects_changed_variant
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::Unexpected;
+
+        fn wrong() {
+            let value = Unexpected::Unsigned(42);
+            assert(value is Signed); // FAILS
+        }
+    } => Err(err) => {
+        assert!(err.errors[0].message.contains("assertion failed"));
+        assert_one_fails(err);
+    }
+}
