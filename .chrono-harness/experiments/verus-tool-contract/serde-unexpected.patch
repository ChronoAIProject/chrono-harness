+#![feature(rustc_private)]
+#[macro_use]
+mod common;
+use common::*;
+
+test_verify_one_file_with_options! {
+    #[test] serde_unexpected_preserves_scalar_fields_and_float_variant
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::Unexpected;
+
+        fn scalars(flag: bool, unsigned: u64, signed: i64, character: char, float: f64) {
+            let value = Unexpected::Bool(flag);
+            match value {
+                Unexpected::Bool(actual) => assert(actual == flag),
+                _ => assert(false),
+            }
+            let value = Unexpected::Unsigned(unsigned);
+            match value {
+                Unexpected::Unsigned(actual) => assert(actual == unsigned),
+                _ => assert(false),
+            }
+            let value = Unexpected::Signed(signed);
+            match value {
+                Unexpected::Signed(actual) => assert(actual == signed),
+                _ => assert(false),
+            }
+            let value = Unexpected::Char(character);
+            match value {
+                Unexpected::Char(actual) => assert(actual == character),
+                _ => assert(false),
+            }
+            let value = Unexpected::Float(float);
+            assert(value is Float);
+        }
+    } => Ok(())
+}
+
+test_verify_one_file_with_options! {
+    #[test] serde_unexpected_preserves_complete_borrowed_fields
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::Unexpected;
+
+        fn text<'a>(input: &'a str) -> (result: Unexpected<'a>)
+            ensures match result {
+                Unexpected::Str(actual) => actual@ == input@,
+                _ => false,
+            },
+        {
+            Unexpected::Str(input)
+        }
+
+        fn other<'a>(input: &'a str) -> (result: Unexpected<'a>)
+            ensures match result {
+                Unexpected::Other(actual) => actual@ == input@,
+                _ => false,
+            },
+        {
+            Unexpected::Other(input)
+        }
+
+        fn bytes<'a>(input: &'a [u8]) -> (result: Unexpected<'a>)
+            ensures match result {
+                Unexpected::Bytes(actual) => actual@ == input@,
+                _ => false,
+            },
+        {
+            Unexpected::Bytes(input)
+        }
+    } => Ok(())
+}
+
+test_verify_one_file_with_options! {
+    #[test] serde_unexpected_preserves_all_unit_variants
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::de::Unexpected;
+
+        fn variants() {
+            assert(Unexpected::Unit is Unit);
+            assert(Unexpected::Option is Option);
+            assert(Unexpected::NewtypeStruct is NewtypeStruct);
+            assert(Unexpected::Seq is Seq);
+            assert(Unexpected::Map is Map);
+            assert(Unexpected::Enum is Enum);
+            assert(Unexpected::UnitVariant is UnitVariant);
+            assert(Unexpected::NewtypeVariant is NewtypeVariant);
+            assert(Unexpected::TupleVariant is TupleVariant);
+            assert(Unexpected::StructVariant is StructVariant);
+        }
+    } => Ok(())
+}
