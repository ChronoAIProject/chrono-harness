+#![feature(rustc_private)]
+#[macro_use]
+mod common;
+use common::*;
+
+test_verify_one_file_with_options! {
+    #[test] serde_serializer_forwards_scalar_and_named_arguments
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::Serializer;
+
+        fn boolean<S: Serializer>(s: S, value: bool) -> Result<S::Ok, S::Error> {
+            s.serialize_bool(value)
+        }
+
+        fn signed<S: Serializer>(s: S, value: i128) -> Result<S::Ok, S::Error> {
+            s.serialize_i128(value)
+        }
+
+        fn unsigned<S: Serializer>(s: S, value: u128) -> Result<S::Ok, S::Error> {
+            s.serialize_u128(value)
+        }
+
+        fn float<S: Serializer>(s: S, value: f64) -> Result<S::Ok, S::Error> {
+            s.serialize_f64(value)
+        }
+
+        fn character<S: Serializer>(s: S, value: char) -> Result<S::Ok, S::Error> {
+            s.serialize_char(value)
+        }
+
+        fn text<S: Serializer>(s: S, value: &str) -> Result<S::Ok, S::Error> {
+            s.serialize_str(value)
+        }
+
+        fn bytes<S: Serializer>(s: S, value: &[u8]) -> Result<S::Ok, S::Error> {
+            s.serialize_bytes(value)
+        }
+
+        fn some<S: Serializer, T: ?Sized + serde::Serialize>(s: S, value: &T)
+            -> Result<S::Ok, S::Error>
+        {
+            s.serialize_some(value)
+        }
+
+        fn unit<S: Serializer>(s: S, name: &'static str, index: u32, variant: &'static str)
+            -> Result<S::Ok, S::Error>
+        {
+            s.serialize_unit_variant(name, index, variant)
+        }
+
+        fn named<S: Serializer, T: ?Sized + serde::Serialize>(
+            s: S, name: &'static str, index: u32, variant: &'static str, value: &T,
+        ) -> Result<S::Ok, S::Error> {
+            s.serialize_newtype_variant(name, index, variant, value)
+        }
+
+        fn readable<S: Serializer>(s: &S) -> bool { s.is_human_readable() }
+    } => Ok(())
+}
+
+test_verify_one_file_with_options! {
+    #[test] serde_serializer_keeps_all_seven_compound_types_and_errors
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+        use serde::Serializer;
+        use serde::ser::{SerializeSeq, SerializeTuple, SerializeTupleStruct,
+            SerializeTupleVariant, SerializeMap, SerializeStruct, SerializeStructVariant};
+
+        fn seq<S: Serializer, T: ?Sized + serde::Serialize>(s: S, len: Option<usize>, value: &T)
+            -> Result<S::Ok, S::Error>
+        {
+            let mut state = s.serialize_seq(len)?;
+            state.serialize_element(value)?;
+            state.end()
+        }
+
+        fn tuple<S: Serializer, T: ?Sized + serde::Serialize>(s: S, len: usize, value: &T)
+            -> Result<S::Ok, S::Error>
+        {
+            let mut state = s.serialize_tuple(len)?;
+            state.serialize_element(value)?;
+            state.end()
+        }
+
+        fn tuple_struct<S: Serializer, T: ?Sized + serde::Serialize>(
+            s: S, name: &'static str, len: usize, value: &T,
+        ) -> Result<S::Ok, S::Error> {
+            let mut state = s.serialize_tuple_struct(name, len)?;
+            state.serialize_field(value)?;
+            state.end()
+        }
+
+        fn tuple_variant<S: Serializer, T: ?Sized + serde::Serialize>(
+            s: S, name: &'static str, index: u32, variant: &'static str, len: usize, value: &T,
+        ) -> Result<S::Ok, S::Error> {
+            let mut state = s.serialize_tuple_variant(name, index, variant, len)?;
+            state.serialize_field(value)?;
+            state.end()
+        }
+
+        fn map<S: Serializer, K: ?Sized + serde::Serialize, V: ?Sized + serde::Serialize>(
+            s: S, len: Option<usize>, key: &K, value: &V,
+        ) -> Result<S::Ok, S::Error> {
+            let mut state = s.serialize_map(len)?;
+            state.serialize_entry(key, value)?;
+            state.end()
+        }
+
+        fn record<S: Serializer, T: ?Sized + serde::Serialize>(
+            s: S, name: &'static str, len: usize, key: &'static str, value: &T,
+        ) -> Result<S::Ok, S::Error> {
+            let mut state = s.serialize_struct(name, len)?;
+            state.serialize_field(key, value)?;
+            state.skip_field(key)?;
+            state.end()
+        }
+
+        fn record_variant<S: Serializer, T: ?Sized + serde::Serialize>(
+            s: S, name: &'static str, index: u32, variant: &'static str,
+            len: usize, key: &'static str, value: &T,
+        ) -> Result<S::Ok, S::Error> {
+            let mut state = s.serialize_struct_variant(name, index, variant, len)?;
+            state.serialize_field(key, value)?;
+            state.skip_field(key)?;
+            state.end()
+        }
+    } => Ok(())
+}
