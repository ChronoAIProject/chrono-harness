+test_verify_one_file_with_options! {
+    #[test] serde_serialize_checks_local_implementation_and_real_derives
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+
+        struct Value { flag: bool }
+
+        impl serde::Serialize for Value {
+            fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                serializer.serialize_bool(self.flag)
+            }
+        }
+
+        #[derive(serde::Serialize)]
+        struct Record { count: u64, flag: bool }
+
+        #[derive(serde::Serialize)]
+        enum Choice { Unit, Tuple(u64), Record { flag: bool } }
+
+        fn forward<S: serde::Serializer>(value: &Record, serializer: S) -> Result<S::Ok, S::Error> {
+            serde::Serialize::serialize(value, serializer)
+        }
+    } => Ok(())
+}
+
+test_verify_one_file_with_options! {
+    #[test] serde_serializer_does_not_assume_success
+    ["--no-cheating", "--no-external-by-default"] => verus_code! {
+        use vstd::prelude::*;
+
+        fn wrong<S: serde::Serializer>(serializer: S, value: bool) {
+            let result = serializer.serialize_bool(value);
+            assert(result is Ok); // FAILS
+        }
+    } => Err(err) => {
+        assert!(err.errors[0].message.contains("assertion failed"));
+        assert_one_fails(err);
+    }
+}
