+// Rust supplies the Fn-family object impls implicitly. Keep the same callable
+// bounds and inherited FnOnce::Output in VIR; this does not assert requires or
+// ensures for any value of the dynamic type.
+fn add_dyn_callable_impls(
+    ctx: &GlobalCtx,
+    krate: &Krate,
+    trait_impls: &mut Vec<TraitImpl>,
+    assoc_type_impls: &mut Vec<AssocTypeImpl>,
+) {
+    use crate::ast::{GenericBoundX, Sizedness, TraitId};
+    let mut paths: Vec<_> = crate::traits::get_dyn_traits(krate).into_iter().collect();
+    paths.sort_by_key(crate::ast_util::path_as_friendly_rust_name);
+    for principal in paths {
+        let Some(principal_kind) = ClosureKind::from_trait_path(&principal) else { continue };
+        let args_name = Arc::new("DynCallableArgs".to_owned());
+        let output_name = Arc::new("DynCallableOutput".to_owned());
+        let typ_params = Arc::new(vec![args_name.clone(), output_name.clone()]);
+        let args = Arc::new(TypX::TypParam(args_name));
+        let output = Arc::new(TypX::TypParam(output_name));
+        let self_typ = Arc::new(TypX::Dyn(
+            principal.clone(), Arc::new(vec![args.clone()]), Some(output.clone()), Arc::new(vec![]),
+        ));
+        let trait_typ_args = Arc::new(vec![self_typ, args.clone()]);
+        let typ_bounds = Arc::new(vec![
+            Arc::new(GenericBoundX::Trait(
+                TraitId::Path(crate::path![CrateId::Core => "marker", "Tuple"]), Arc::new(vec![args.clone()]),
+            )),
+            Arc::new(GenericBoundX::Trait(TraitId::Sizedness(Sizedness::Sized), Arc::new(vec![args]))),
+            Arc::new(GenericBoundX::Trait(TraitId::Sizedness(Sizedness::Sized), Arc::new(vec![output.clone()]))),
+        ]);
+        for kind in [ClosureKind::FnOnce, ClosureKind::FnMut, ClosureKind::Fn] {
+            if (principal_kind == ClosureKind::FnOnce && kind != ClosureKind::FnOnce)
+                || (principal_kind == ClosureKind::FnMut && kind == ClosureKind::Fn) { continue }
+            let impl_path = Arc::new(crate::ast::PathX {
+                krate: CrateId::Internal,
+                segments: Arc::new(vec![crate::ast::Segment::T(Arc::new(format!("impl_dyn_callable&%{principal_kind}&%{kind}")), 0)]),
+            });
+            let trait_implx = crate::ast::TraitImplX {
+                impl_path: impl_path.clone(), typ_params: typ_params.clone(), typ_bounds: typ_bounds.clone(),
+                trait_path: kind.trait_path(), trait_typ_args: trait_typ_args.clone(),
+                trait_typ_arg_impls: Spanned::new(ctx.no_span.clone(), Arc::new(vec![])),
+                owning_module: None, auto_imported: true, external_trait_blanket: false,
+            };
+            trait_impls.push(Spanned::new(ctx.no_span.clone(), trait_implx));
+            if kind == ClosureKind::FnOnce {
+                assoc_type_impls.push(Spanned::new(ctx.no_span.clone(), crate::ast::AssocTypeImplX {
+                    name: Arc::new("Output".to_owned()), impl_path,
+                    typ_params: typ_params.clone(), typ_bounds: typ_bounds.clone(),
+                    trait_path: kind.trait_path(), trait_typ_args: trait_typ_args.clone(),
+                    typ: output.clone(), impl_paths: Arc::new(vec![]),
+                }));
+            }
+        }
+    }
+}
