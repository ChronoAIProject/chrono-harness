    },
    {
      "id": "configuration.ancestor-2.config.toml",
      "location": {
        "path": "/Users/runner/.cargo/config.toml"
      }
    },
    {
      "id": "configuration.ancestor-3.config",
      "location": {
        "path": "/Users/.cargo/config"
      }
    },
    {
      "id": "configuration.ancestor-3.config.toml",
      "location": {
        "path": "/Users/.cargo/config.toml"
      }
    },
    {
      "id": "configuration.ancestor-4.config",
      "location": {
        "path": "/.cargo/config"
      }
    },
    {
      "id": "configuration.ancestor-4.config.toml",
      "location": {
        "path": "/.cargo/config.toml"
      }
    }
  ],
  "directories": [
    {
      "id": "rust",
      "location": {
        "stdout": "rust.sysroot"
      },
      "max_entries": 200000,
      "manifest": {
        "path": ".chrono-harness/state/diagnostics-native/guard-inputs/rust.json",
        "root": "/Users/runner/.rustup/toolchains/1.95.0-aarch64-apple-darwin"
      }
    },
    {
      "id": "sdk",
      "location": {
        "stdout": "sdk.root"
      },
      "max_entries": 200000,
      "manifest": {
        "path": ".chrono-harness/state/diagnostics-native/guard-inputs/sdk.json",
        "root": "/Applications/Xcode_26.6.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
      }
    },
    {
      "id": "developer",
      "location": {
        "path": "/Applications/Xcode_26.6.app/Contents"
      },
      "max_entries": 200000,
      "manifest": {
        "path": ".chrono-harness/state/diagnostics-native/guard-inputs/xcode-contents.json",
        "root": "/Applications/Xcode_26.6.app/Contents"
      }
    },
    {
      "id": "cargo-registry",
      "location": {
        "path": ".chrono-harness/state/diagnostics-native/cargo/registry"
      },
      "max_entries": 200000,
      "manifest": {
        "path": ".chrono-harness/state/diagnostics-native/guard-inputs/packages.json",
        "root": ".chrono-harness/state/diagnostics-native/cargo/registry"
      }
    }
  ],
  "stop_on_failure": true
}
