    },
    {
      "id": "tool.ld",
      "location": {
        "stdout": "selection.ld"
      },
      "resolution": "canonical-target"
    },
    {
      "id": "tool.libtool",
      "location": {
        "stdout": "selection.libtool"
      },
      "resolution": "canonical-target"
    },
    {
      "id": "tool.dsymutil",
      "location": {
        "stdout": "selection.dsymutil"
      },
      "resolution": "canonical-target"
    },
    {
      "id": "configuration.checkout.config",
      "location": {
        "path": ".cargo/config"
      }
    },
    {
      "id": "configuration.checkout.config.toml",
      "location": {
        "path": ".cargo/config.toml"
      }
    },
    {
      "id": "configuration.cargo-home.config",
      "location": {
        "path": ".chrono-harness/state/diagnostics-native/cargo/config"
      }
    },
    {
      "id": "configuration.cargo-home.config.toml",
      "location": {
        "path": ".chrono-harness/state/diagnostics-native/cargo/config.toml"
      }
    },
    {
      "id": "configuration.ancestor-0.config",
      "location": {
        "path": "/Users/runner/work/chrono-harness/.cargo/config"
      }
    },
    {
      "id": "configuration.ancestor-0.config.toml",
      "location": {
        "path": "/Users/runner/work/chrono-harness/.cargo/config.toml"
      }
    },
    {
      "id": "configuration.ancestor-1.config",
      "location": {
        "path": "/Users/runner/work/.cargo/config"
      }
    },
    {
      "id": "configuration.ancestor-1.config.toml",
      "location": {
        "path": "/Users/runner/work/.cargo/config.toml"
      }
    },
    {
      "id": "configuration.ancestor-2.config",
      "location": {
