{
  "schema": "chrono-input-observation/v1",
  "platforms": [
    "macos-aarch64"
  ],
  "environment": {
    "inherit": [
      "PATH",
      "HOME",
      "TMPDIR",
      "CARGO_HOME",
      "RUSTUP_HOME",
      "RUSTUP_TOOLCHAIN",
      "RUSTC",
      "RUSTC_WRAPPER",
      "RUSTC_WORKSPACE_WRAPPER",
      "RUSTFLAGS",
      "CARGO_NET_OFFLINE",
      "SDKROOT",
      "DEVELOPER_DIR",
      "CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER",
      "CHRONO_XCODE_CONTENTS"
    ],
    "values": {
      "CARGO_TERM_COLOR": "never"
    }
  },
  "operations": [
    {
      "id": "selection.cargo",
      "program": "rustup",
      "argv": [
        "which",
        "--toolchain",
        "1.95.0",
        "cargo"
      ],
      "timeout_seconds": 120,
      "output_limit_bytes": 1048576
    },
    {
      "id": "selection.rustc",
      "program": "rustup",
      "argv": [
        "which",
        "--toolchain",
        "1.95.0",
        "rustc"
      ],
      "timeout_seconds": 120,
      "output_limit_bytes": 1048576
    }
  ],
  "registered_operations": {
    "projects": ".chrono-harness/projects.json",
    "operations": [
      "inputs.fetch.runner",
      "inputs.vendor.runner",
      "guard.check.runner"
    ],
    "tools": {
      "cargo": {
        "stdout": "selection.cargo"
      },
      "cargo-guard": ".chrono-harness/bin/chrono-judge-cargo"
    },
    "timeout_seconds": 120,
    "output_limit_bytes": 1048576,
    "operation_bounds": {
      "guard.check.runner": {
        "timeout_seconds": 600,
        "output_limit_bytes": 4194304
      }
    },
    "environment": {
      "RUSTC": {
        "stdout": "selection.rustc"
      }
    }
  },
  "files": [],
  "directories": [],
  "stop_on_failure": true
}
