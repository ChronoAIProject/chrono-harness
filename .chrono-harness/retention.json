{
  "schema": "chrono-output-retention/v2",
  "producers": {
    "worktree-fixture": [
      ".chrono-harness/state/worktree-test-failures/",
      ".chrono-harness/state/worktree-test-receipts/"
    ],
    "cache-fixture": [
      ".chrono-harness/state/cache-test-failures/"
    ],
    "ci-fixture": [
      ".chrono-harness/state/ci-test-failures/"
    ],
    "check-original": [
      ".chrono-harness/state/"
    ],
    "full-original": [
      ".chrono-harness/state/"
    ],
    "lifecycle-original": [
      ".chrono-harness/state/worktrees/",
      ".chrono-harness/state/automatic-cleanup-v2/"
    ]
  },
  "keep_seconds": 0,
  "diagnostic_keep_seconds": 86400,
