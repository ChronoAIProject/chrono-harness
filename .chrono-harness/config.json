{
  "schema_version": 1,
  "status": "proposed",
  "enforcement": "not-implemented",
  "runner": {
    "path": ".chrono-harness/bin/chrono-harness",
    "version": "0.1.0",
    "sha256": null
  },
  "registries": {
    "judges": ".chrono-harness/judges.json",
    "projects": ".chrono-harness/projects.json",
    "filemap": ".chrono-harness/FILEMAP.json",
    "workflow": ".chrono-harness/workflow.json"
  },
  "canonical_check": {
    "operation": "validate.delta",
    "argv": [
      ".chrono-harness/bin/chrono-harness",
      "check",
      "--config",
      ".chrono-harness/ci/check.json",
      "--base",
      "{base}",
      "--candidate",
      "{candidate}"
    ]
  },
  "tools": [
    {
      "id": "cargo",
      "program": "cargo",
      "resolution": "PATH-once",
      "version_argv": [
        "--version"
      ],
      "expected_version": "cargo 1.95.0 (f2d3ce0bd 2026-03-21)"
    },
    {
      "id": "python3",
      "program": "/usr/bin/python3",
      "resolution": "PATH-once",
      "version_argv": [
        "--version"
      ],
      "expected_version": "Python 3.9.6"
    },
    {
      "id": "chrono-ci",
      "program": ".chrono-harness/bin/chrono-ci",
      "resolution": "PATH-once",
      "version_argv": [
        "--version"
      ],
      "expected_version": "chrono-ci 0.1.0"
    }
  ],
  "protocol": {
    "id": "chrono-judge/v1",
    "timeout_seconds": 120,
    "stdout_limit_bytes": 1048576,
    "encoding": "UTF-8"
  },
  "semantic_fields": [
    {
      "path": ".chrono-harness/projects.json",
      "pointers": [
        "/projects/*/actions",
        "/scripts/*/actions"
      ],
      "on": "add-modify-delete"
    },
    {
      "path": ".chrono-harness/FILEMAP.json",
      "pointers": [
        "/files/*/surface",
        "/execution_plans"
      ],
      "on": "modify-delete-existing"
    },
    {
      "path": ".chrono-harness/workflow.json",
      "pointers": [
        "/historical_profiles",
        "/migrations",
        "/retirements"
      ],
      "on": "add-modify-delete"
    },
    {
      "path": ".chrono-harness/config.json",
      "pointers": [
        "/tools",
        "/environment",
        "/canonical_check"
      ],
      "on": "add-modify-delete"
    }
  ],
  "artifacts": [
    {
      "path": ".chrono-harness/bin/",
      "owner": "repository",
      "kind": "generated-executables",
      "tracked": false
    },
    {
      "path": ".chrono-harness/state/",
      "owner": "repository",
      "kind": "execution-evidence",
      "tracked": false
    },
    {
      "path": "crates/runner/target/",
      "owner": "runner",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/runner-tests/target/",
      "owner": "runner-tests",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/instructions/target/",
      "owner": "instructions",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/instructions-tests/target/",
      "owner": "instructions-tests",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-ci/target/",
      "owner": "judge-ci",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-ci-tests/target/",
      "owner": "judge-ci-tests",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/ci/target/",
      "owner": "ci",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/ci-tests/target/",
      "owner": "ci-tests",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-registration/target/",
      "owner": "judge-registration",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-registration-tests/target/",
      "owner": "judge-registration-tests",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-filemap/target/",
      "owner": "judge-filemap",
      "kind": "cargo-output",
      "tracked": false
    },
    {
      "path": "crates/judge-filemap-tests/target/",
      "owner": "judge-filemap-tests",
