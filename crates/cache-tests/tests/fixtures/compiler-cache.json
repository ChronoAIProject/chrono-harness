{
  "schema": "chrono-cache/v2",
  "namespace": "compiler-contract-fixture",
  "artifact_registry": ".chrono-harness/git/pinned-macos.json",
  "require_primary_checkout": false,
  "inputs": {
    "rustc.version": {
      "kind": "command",
      "command": {
        "program": "rustup",
        "args": [
          "run",
          "1.95.0",
          "rustc",
          "--version",
          "--verbose"
        ],
        "env": {
          "CARGO_HOME": ".chrono-harness/cache/bootstrap-owner-tooling/cargo"
        },
        "timeout_seconds": 30,
        "output_limit_bytes": 65536
      },
      "inherit": [
        "PATH",
        "HOME",
        "RUSTUP_HOME"
      ],
      "result": "stdout"
    },
    "cache.manifest": {
      "kind": "file",
      "path": "crates/cache/Cargo.toml",
      "presence": "present"
    },
    "cache.lock": {
      "kind": "file",
      "path": "crates/cache/Cargo.lock",
      "presence": "present"
    },
    "cache.sources": {
      "kind": "registered-files",
      "registry": ".chrono-harness/FILEMAP.json",
      "node": "project:cache",
      "edges": [
        "compile"
      ]
    },
    "cache-tests.manifest": {
      "kind": "file",
      "path": "crates/cache-tests/Cargo.toml",
      "presence": "present"
    },
    "cache-tests.lock": {
      "kind": "file",
      "path": "crates/cache-tests/Cargo.lock",
      "presence": "present"
    },
    "cache-tests.sources": {
      "kind": "registered-files",
      "registry": ".chrono-harness/FILEMAP.json",
      "node": "project:cache-tests",
      "edges": [
        "compile"
      ]
    },
    "cache.producer": {
      "kind": "json-value",
      "path": ".chrono-harness/projects.json",
      "pointer": "/projects/32/actions/build"
    },
    "cache-tests.producer": {
      "kind": "json-value",
      "path": ".chrono-harness/projects.json",
      "pointer": "/projects/33/actions/execute"
    },
    "cache.cargo-registration": {
      "kind": "json-value",
      "path": ".chrono-harness/git/pinned-macos.json",
      "pointer": "/tools/0"
    }
  },
  "artifacts": {
    "cache.target": {
      "owner": "cache",
      "path": "crates/cache/target/"
    },
    "cache-tests.target": {
      "owner": "cache-tests",
      "path": "crates/cache-tests/target/"
    }
  },
  "caches": {
    "compiler.cache": {
      "owner": "cache",
      "producer": "build.cache",
      "consumers": [
        "test.compiler"
      ],
      "artifacts": [
        "cache.target"
      ],
      "compatibility_inputs": [
        "rustc.version",
        "cache.manifest",
        "cache.lock",
        "cache.producer",
        "cache.cargo-registration"
      ],
      "source_inputs": [
        "cache.sources"
      ],
      "restore": "compatible"
    },
    "compiler.cache-tests": {
      "owner": "cache-tests",
      "producer": "test.cache-tests",
      "consumers": [
        "test.compiler"
      ],
      "artifacts": [
        "cache-tests.target"
      ],
      "compatibility_inputs": [
        "rustc.version",
        "cache.manifest",
        "cache.lock",
        "cache-tests.manifest",
        "cache-tests.lock",
        "cache-tests.producer",
        "cache.cargo-registration"
      ],
      "source_inputs": [
        "cache-tests.sources"
      ],
      "restore": "compatible"
    }
  },
  "consumer_operations": {
    "test.compiler": [
      {
        "registry": ".chrono-harness/FILEMAP.json",
        "pointer": "/execution_plans/test:cache-tests/operations"
      }
    ]
  },
  "recover_failed_restores": false,
  "recover_unconfirmed_restores": false
}
