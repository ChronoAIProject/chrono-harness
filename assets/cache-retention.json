{
  "schema": "chrono-output-retention/v2",
  "producers": {
    "cache-probe-attempt": [
      ".chrono-harness/state/cache-probe-attempts/"
    ]
  },
  "keep_seconds": 0,
  "diagnostic_keep_seconds": 0,
  "metadata_keep_seconds": 86400,
